/* PixelFoundry 浅色主题 —— Krita 风格的停靠面板 / 工具条 / 菜单体系
   ------------------------------------------------------------------
   设计令牌（与 dark.qss 一一对应）：
     窗口底      #e9ecf1      画布底      #d6dae1
     面板(docker)#f7f8fa      面板标题条  #e4e8ee
     输入层      #ffffff      悬停/选中   #e2e6ec / #d2d8e2
     发丝边框    rgba(15,23,42,0.10)    强调色 #3f6fe0 */

* {
    font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei UI", "Noto Sans SC", sans-serif;
    font-size: 13px;
    outline: none;
}

QMainWindow, QWidget {
    background-color: #e9ecf1;
    color: #1a1d23;
}

QDialog {
    background-color: #f2f4f7;
}

/* ================= 菜单栏 ================= */
QMenuBar {
    background-color: #dfe4ec;
    color: #23272e;
    border-bottom: 1px solid rgba(15, 23, 42, 0.10);
    padding: 1px 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 11px;
    border-radius: 5px;
}
QMenuBar::item:selected {
    background-color: #cdd5e2;
}
QMenuBar::item:pressed {
    background-color: #bfc9da;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.14);
    border-radius: 8px;
    padding: 5px;
    color: #1a1d23;
}
QMenu::item {
    padding: 6px 26px 6px 22px;
    border-radius: 5px;
}
QMenu::item:selected {
    background-color: #3f6fe0;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #9aa1ab;
}
QMenu::separator {
    height: 1px;
    background: rgba(15, 23, 42, 0.10);
    margin: 4px 8px;
}

/* ================= 工具条 ================= */
QToolBar, #AppToolBar {
    background-color: #dfe4ec;
    border: none;
    border-bottom: 1px solid rgba(15, 23, 42, 0.10);
    padding: 2px 6px;
    spacing: 3px;
}
QToolBar::separator {
    background: rgba(15, 23, 42, 0.12);
    width: 1px;
    margin: 5px 6px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px 8px;
    color: #2a2f37;
}
QToolButton:hover {
    background-color: #cfd6e2;
    border-color: rgba(15, 23, 42, 0.10);
}
QToolButton:pressed {
    background-color: #bfc9da;
}
QToolButton:checked {
    background-color: rgba(63, 111, 224, 0.18);
    border-color: rgba(63, 111, 224, 0.45);
}
QToolButton:disabled {
    color: #9aa1ab;
}

#WorkspaceTitle {
    color: #171a20;
    font-size: 13px;
    font-weight: 600;
}
#InfoChip {
    background-color: #e6eaf1;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 9px;
    color: #5a6270;
    font-size: 11px;
    padding: 2px 9px;
}
QToolButton#ToolbarButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 9px;
    color: #2a2f37;
}
QToolButton#ToolbarButton:hover {
    background-color: #e2e6ec;
    border-color: rgba(15, 23, 42, 0.12);
}
QToolButton#ToolbarButtonPrimary {
    background-color: rgba(63, 111, 224, 0.12);
    border: 1px solid rgba(63, 111, 224, 0.40);
    border-radius: 6px;
    padding: 4px 10px;
    color: #2b4ea8;
    font-weight: 600;
}
QToolButton#ToolbarButtonPrimary:hover {
    background-color: rgba(63, 111, 224, 0.22);
}

/* ================= 侧边导航栏 ================= */
#Sidebar {
    background-color: #e2e6ee;
    border-right: 1px solid rgba(15, 23, 42, 0.10);
}
QPushButton#NavButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 0;
    margin: 4px 9px;
}
QPushButton#NavButton:hover {
    background-color: #d2d8e2;
}
QPushButton#NavButton:pressed {
    background-color: rgba(15, 23, 42, 0.12);
}
QPushButton#NavButton:checked {
    background-color: #c6cedd;
}

QToolButton#ModeSegment {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 0;
}
QToolButton#ModeSegment:hover {
    background-color: rgba(15, 23, 42, 0.08);
}
QToolButton#ModeSegment:checked {
    background-color: #c6cedd;
}

#StepNav {
    background: transparent;
}
QPushButton#StepButton {
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 7px;
    padding: 2px 8px;
    text-align: left;
    color: #59606b;
    font-weight: 500;
}
QPushButton#StepButton:hover {
    background-color: #d9dfe9;
    color: #1a1d23;
}
QPushButton#StepButton:checked {
    background-color: rgba(63, 111, 224, 0.16);
    border-left: 2px solid #3f6fe0;
    color: #16305e;
}

/* ================= Docker（停靠面板） ================= */
#DockerColumn, #SideDock {
    background: transparent;
}
#DockerSplitter::handle, QSplitter#DockerSplitter::handle {
    background-color: transparent;
    height: 6px;
}
#Docker {
    background-color: #f7f8fa;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 8px;
}
#DockerHeader {
    background-color: #e4e8ee;
    border: none;
    border-bottom: 1px solid rgba(15, 23, 42, 0.10);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
#DockerHeader[collapsed="true"] {
    border-bottom: none;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}
#DockerTitle {
    color: #464d59;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
}
QToolButton#DockerChevron, QToolButton#DockToggle {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #5a6270;
    font-size: 11px;
    padding: 0;
}
QToolButton#DockerChevron:hover, QToolButton#DockToggle:hover {
    background-color: rgba(15, 23, 42, 0.10);
    color: #1a1d23;
}
#DockerBody {
    background: transparent;
}
#DockRail {
    background-color: #e4e8ee;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 6px;
    color: #464d59;
}
#DockRail:hover {
    background-color: #d2d8e2;
    color: #1a1d23;
}

/* ================= 分栏与工作区 ================= */
QSplitter::handle {
    background-color: rgba(15, 23, 42, 0.08);
}
QSplitter::handle:horizontal {
    width: 4px;
}
QSplitter::handle:vertical {
    height: 4px;
}
QSplitter::handle:hover {
    background-color: #3f6fe0;
}
QSplitter#Workspace::handle {
    background-color: transparent;
}
QSplitter#Workspace::handle:hover {
    background-color: rgba(63, 111, 224, 0.45);
}
/* 资源栏「目录树 / 缩略图」之间的分隔条：平时细线，悬停变蓝，提示可以拖 */
QSplitter#AssetSplit::handle:vertical {
    height: 6px;
    background-color: rgba(15, 23, 42, 0.03);
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
}
QSplitter#AssetSplit::handle:vertical:hover {
    background-color: rgba(63, 111, 224, 0.45);
}

/* ================= 卡片 ================= */
QGroupBox {
    background-color: #f7f8fa;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 6px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #464d59;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

/* ================= 表单控件 ================= */
QLabel {
    color: #1a1d23;
    background: transparent;
}
QLabel#HintLabel, QLabel#StepLabel {
    color: #6b7280;
    font-size: 12px;
}
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.16);
    border-radius: 6px;
    padding: 5px 8px;
    color: #1a1d23;
    selection-background-color: #3f6fe0;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QSpinBox:hover,
QDoubleSpinBox:hover, QComboBox:hover {
    border: 1px solid rgba(15, 23, 42, 0.28);
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #3f6fe0;
}
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    background-color: #eef1f6;
    border: none;
    width: 15px;
}
QAbstractSpinBox::up-button {
    border-top-right-radius: 5px;
}
QAbstractSpinBox::down-button {
    border-bottom-right-radius: 5px;
}
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #3f6fe0;
}
QAbstractSpinBox::up-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #4a515c;
    width: 0;
    height: 0;
}
QAbstractSpinBox::down-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #4a515c;
    width: 0;
    height: 0;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #4a515c;
    width: 0;
    height: 0;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.16);
    border-radius: 6px;
    selection-background-color: #3f6fe0;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

/* ================= 按钮 ================= */
QPushButton {
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.16);
    border-radius: 6px;
    padding: 6px 13px;
    color: #1a1d23;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #eef1f6;
    border: 1px solid rgba(15, 23, 42, 0.26);
}
QPushButton:pressed {
    background-color: rgba(15, 23, 42, 0.10);
}
QPushButton:disabled {
    color: #9aa1ab;
    background-color: #f0f2f6;
}
QPushButton#PrimaryButton {
    background-color: #3f6fe0;
    border-color: #3f6fe0;
    color: #ffffff;
}
QPushButton#PrimaryButton:hover {
    background-color: #4d7cf0;
    border-color: #4d7cf0;
}
QPushButton#PrimaryButton:pressed {
    background-color: #355ec5;
}
QPushButton#PrimaryButton:disabled {
    background-color: #b9c6e6;
    border-color: #b9c6e6;
    color: #f2f5fb;
}
/* IDE 步骤条：✓ 已完成 / ▶ 当前 / ○ 未开始 */
QPushButton#StepChip {
    background-color: #f4f5f8;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 7px;
    color: #6b7280;
    padding: 4px 10px;
    text-align: left;
}
QPushButton#StepChip:hover {
    border-color: rgba(15, 23, 42, 0.22);
    color: #2b3038;
}
QPushButton#StepChip[stepState="done"] {
    background-color: #e8f5ec;
    border-color: #8dc9a2;
    color: #2f7d4a;
}
QPushButton#StepChip[stepState="current"] {
    background-color: #e6eeff;
    border-color: #4176e6;
    color: #1d3f8f;
    font-weight: 600;
}
QLabel#FirstFrameThumb {
    background-color: #f2f3f6;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 6px;
}
QPushButton#DangerButton {
    background-color: rgba(220, 70, 76, 0.12);
    border-color: rgba(220, 70, 76, 0.4);
    color: #c02a30;
}
QPushButton#DangerButton:hover {
    background-color: rgba(220, 70, 76, 0.20);
}
QPushButton#ToolBtn {
    padding: 4px 8px;
    font-size: 12px;
}
QPushButton#ToolBtn:disabled {
    color: #9aa1ab;
    background-color: #f0f2f6;
}
QPushButton#SegmentButton {
    padding: 3px 6px;
    border: 1px solid rgba(15, 23, 42, 0.14);
    border-radius: 6px;
    background: #eef1f6;
    color: #5a6270;
    font-size: 11px;
}
QPushButton#SegmentButton:hover {
    background: #e2e6ec;
    color: #1a1d23;
}
QPushButton#SegmentButton:checked {
    background: rgba(63, 111, 224, 0.18);
    border-color: rgba(63, 111, 224, 0.55);
    color: #16305e;
    font-weight: 600;
}

/* ================= 进度条 ================= */
QProgressBar {
    background-color: #dde2ea;
    border: none;
    border-radius: 5px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #3f6fe0;
    border-radius: 5px;
}

/* ================= 日志 ================= */
QPlainTextEdit#LogView {
    background-color: #f3f5f8;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 7px;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    color: #5a6270;
    padding: 7px;
}

/* ================= 滚动条 ================= */
QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #c2c9d4;
    border-radius: 4px;
    min-height: 26px;
}
QScrollBar::handle:vertical:hover {
    background: #a7b0bf;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 9px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #c2c9d4;
    border-radius: 4px;
    min-width: 26px;
}
QScrollBar::handle:horizontal:hover {
    background: #a7b0bf;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ================= 复选框 / 单选 ================= */
QCheckBox, QRadioButton {
    color: #1a1d23;
    spacing: 7px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
}
QCheckBox::indicator {
    border: 1px solid rgba(15, 23, 42, 0.26);
    border-radius: 4px;
    background: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #3f6fe0;
}
QCheckBox::indicator:checked {
    background: #3f6fe0;
    border-color: #3f6fe0;
}

/* ================= 状态栏 ================= */
QStatusBar {
    background-color: #e2e6ee;
    color: #5a6270;
    border-top: 1px solid rgba(15, 23, 42, 0.10);
}
QStatusBar::item {
    border: none;
}

/* ================= 区域 / 页签 ================= */
QScrollArea {
    border: none;
    background: transparent;
}
QTabWidget::pane {
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 8px;
    background-color: #f7f8fa;
    top: -1px;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background: transparent;
    color: #5a6270;
    padding: 6px 15px;
    margin-right: 2px;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    font-weight: 500;
}
QTabBar::tab:selected {
    background-color: #f7f8fa;
    border-color: rgba(15, 23, 42, 0.10);
    border-top: 2px solid #3f6fe0;
    color: #16305e;
}
QTabBar::tab:hover {
    color: #1a1d23;
}

/* ================= 列表 / 树 ================= */
QListWidget, QTreeWidget, QListView, QTreeView, QTableView {
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 7px;
    padding: 3px;
    outline: none;
    alternate-background-color: #f5f7fa;
}
QListWidget::item, QTreeWidget::item {
    border-radius: 5px;
    padding: 4px 8px;
    color: #262b33;
}
QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: rgba(15, 23, 42, 0.06);
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: rgba(63, 111, 224, 0.22);
    color: #16305e;
}
QTreeWidget::branch:has-children:closed {
    image: none;
    border-left: 4px solid transparent;
    border-right: 5px solid #6b7280;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    width: 0;
    height: 0;
}
QTreeWidget::branch:has-children:open {
    image: none;
    border-left: 4px solid #6b7280;
    border-right: 4px solid transparent;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    width: 0;
    height: 0;
}
QHeaderView::section {
    background-color: #e4e8ee;
    color: #464d59;
    border: none;
    border-right: 1px solid rgba(15, 23, 42, 0.10);
    padding: 5px 8px;
}

QListWidget#PackList {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 6px;
    font-size: 12px;
}
QTreeWidget#PackTree {
    background: #fbfcfd;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 6px;
    font-size: 12px;
}
QListWidget#AssetGrid {
    background: #fbfcfd;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 7px;
}
QListWidget#AssetGrid::item {
    color: #3a4048;
    padding: 3px;
    border-radius: 5px;
}
QListWidget#AssetGrid::item:hover {
    background: rgba(15, 23, 42, 0.06);
}
QListWidget#AssetGrid::item:selected {
    background: rgba(63, 111, 224, 0.26);
    color: #16305e;
    border: 1px solid rgba(63, 111, 224, 0.60);
}

/* ================= 编辑器图标列 / 调色板条 ================= */
#EditorSidePanel {
    background-color: #e4e8ee;
    border-left: 1px solid rgba(15, 23, 42, 0.10);
}
#EditorPaletteBar {
    background-color: #e4e8ee;
    border-top: 1px solid rgba(15, 23, 42, 0.10);
}
#EditorSidePanel QToolButton, #EditorPaletteBar QToolButton {
    border-radius: 6px;
    background: transparent;
    border: none;
}
#EditorSidePanel QToolButton:hover, #EditorPaletteBar QToolButton:hover {
    background: rgba(15, 23, 42, 0.10);
}
#EditorSidePanel QToolButton:checked {
    background: rgba(63, 111, 224, 0.35);
}
#EditorSidePanel QToolButton:pressed {
    background: rgba(15, 23, 42, 0.16);
}

/* ================= 设置弹窗分类列表 ================= */
QListWidget#SettingsCatList {
    background: #f2f4f7;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 8px;
    padding: 5px;
}
QListWidget#SettingsCatList::item {
    padding: 7px 10px;
    border-radius: 6px;
    color: #3a4048;
}
QListWidget#SettingsCatList::item:selected {
    background: rgba(63, 111, 224, 0.20);
    color: #16305e;
}

/* ================= 提示浮层 ================= */
QToolTip {
    background-color: #ffffff;
    color: #1a1d23;
    border: 1px solid rgba(15, 23, 42, 0.18);
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 12px;
}
